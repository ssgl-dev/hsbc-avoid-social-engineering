      "start": 413.2,
      "end": 424.74,
      "duration": 11.54
    },
    {
      "index": "11.35",
      "text": "第3步",
      "selector": "body:nth-of-type(1)>main:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>div:nth-of-type(7)>#content_main_masterCard_2>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(2)>div:nth-of-type(2)>#content_main_card_8>#content_main_title_10>h3:nth-of-type(1)",
      "selector_en": "",
      "file": "11.35.mp4",
      "start": 424.74,
      "end": 427.82,
      "duration": 3.08
    },
    {
